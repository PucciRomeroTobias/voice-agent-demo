# Credenciales de LiveKit Cloud. No subir .env.local al repositorio.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Proveedor único de STT, LLM y TTS. Cargar como secreto en LiveKit Cloud;
# nunca enviarlo al navegador ni versionarlo.
OPENAI_API_KEY=

# Sólo para el modo console local cuando todavía no hay metadata de un job.
# Valores permitidos: es, en
VOICE_DEMO_LANGUAGE=es

# Endpoint privado del Worker que guarda transcript y métricas por 30 días.
# El token debe coincidir con el secreto configurado en Cloudflare.
VOICE_OBSERVABILITY_URL=
VOICE_OBSERVABILITY_TOKEN=
